{
  "name": "vscode-simple-image-gallery",
  "displayName": "Simple Image Gallery",
  "description": "Rich interactive visual image gallery web GUI for browsing, inspecting, and managing workspace images.",
  "version": "0.0.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/kollinmurphy/vscode-simple-image-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/kollinmurphy/vscode-simple-image-gallery/issues"
  },
  "homepage": "https://github.com/kollinmurphy/vscode-simple-image-gallery#readme",
  "publisher": "KollinMurphy",
  "icon": "icon.png",
  "license": "MIT",
  "pricing": "Free",
  "qna": "marketplace",
  "keywords": [
    "image",
    "gallery",
    "photos",
    "assets",
    "viewer",
    "png",
    "svg"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:vscode-simple-image-gallery.openGallery",
    "onCommand:vscode-simple-image-gallery.openGalleryForFolder",
    "onWebviewPanel:vscode-simple-image-gallery.galleryPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-simple-image-gallery.openGallery",
        "title": "Open gallery for workspace",
        "category": "Image Gallery",
        "icon": "$(file-media)"
      },
      {
        "command": "vscode-simple-image-gallery.openGalleryForFolder",
        "title": "Open gallery for folder",
        "category": "Image Gallery",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vscode-simple-image-gallery.reopenLastGallery",
        "title": "Reopen Last Gallery Tab",
        "category": "Image Gallery",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-simple-image-gallery.reopenLastGallery",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "vscode-simple-image-gallery.galleryClosed"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vscode-simple-image-gallery.openGallery"
        },
        {
          "command": "vscode-simple-image-gallery.openGalleryForFolder"
        }
      ],
      "editor/title": [
        {
          "command": "vscode-simple-image-gallery.openGallery",
          "group": "navigation",
          "when": "resourceScheme != 'vscode-webview' && resourceScheme != 'webview-panel' && resourceExtname =~ /\\.(avif|bmp|gif|ico|jpeg|jpg|png|svg|webp)$/i"
        }
      ],
      "explorer/context": [
        {
          "command": "vscode-simple-image-gallery.openGalleryForFolder",
          "group": "8_imageGallery@1",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "build": "npm run check-types && npm run lint && node esbuild.js --production",
    "package": "vsce package",
    "publish": "vsce publish",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test:unit": "vscode-test",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.13.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.3.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "@azure/msal-node": "^7.1.0"
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  }
}
